[resource]
script = ExtResource("1")
id = &"hv3_harvester_hive"
display_name = "HV-3 Harvester Hive"
description = "A hive grafted into the left hand. Select it on the D-pad and press LB with a man near the crosshair: the hand comes up, the iris in the palm blooms open, and a few hundred harvester microdrones pour out at him. They wrap him and strip him to the muscle in under a second, then stream back into the palm with what they took, and the hive's reactor turns it into repair nanites in your blood: over a third of your health, back at once. An emergency heal that kills."
location = 7
mount = &"hand_left"
mass_kg = 1.4
power_draw_w = 10.0
heat_w = 5.0
capacity = 2
modifiers = Array[ExtResource("2")]([])
requirements = Array[ExtResource("5")]([SubResource("req_0")])
synergy = "Needs processing ×1.10 (SA-2). Heals 38 % of max health, so a tougher body gets more back. Connectivity extends the reach (16 m, 20.5 m with an MR-1, 25 m with an NL-3). The reactor's heat has to go somewhere: cooling sets how fast the hive rebuilds the swarm (about 22 s at 380 W, 15 s with HS-5). Takes the left hand while it works: the gun goes down for under two seconds. Whoever sees a man eaten loses his nerve."
visuals = Array[ExtResource("3")]([SubResource("vis_0")])
