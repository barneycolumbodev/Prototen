[resource]
script = ExtResource("1")
id = &"sd3_shrike_drone"
display_name = "SD-3 Shrike Drone Pod"
description = "A three-tube pod behind the left shoulder. Each tube holds a Shrike: a folding quadcopter with a shaped charge in its nose. Select it on the D-pad, LB launches one and you see through its camera. Left stick flies, right stick looks, A and B climb and sink, RT detonates, LB cuts the link. Fly it into anyone and it goes off. Your body stands where you left it."
location = 15
mass_kg = 4.5
power_draw_w = 20.0
heat_w = 5.0
capacity = 3
modifiers = Array[ExtResource("2")]([])
requirements = Array[ExtResource("5")]([SubResource("req_0")])
synergy = "Needs connectivity 3 (NL-3). Link range = connectivity × 40 m (120 m; 180 m with an MR-1 as well): the picture breaks up near the limit and the drone drops beyond it. Processing sharpens its turning. New drones are printed one every 30 s."
visuals = Array[ExtResource("3")]([SubResource("vis_0")])
