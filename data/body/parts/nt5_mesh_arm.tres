[resource]
script = ExtResource("1")
id = &"nt5_mesh_arm"
display_name = "NT-5 Prehensile Mesh Arm"
description = "The left forearm is a braid of carbon-nanotube muscle mesh. Unbraided it pays out as an eighteen-metre tendril with a four-fingered claw. Select it on the D-pad, LB to unbraid or fold it. RT shoots it at whoever is under the crosshair and hauls him in; he hangs in front of you and takes the rounds meant for you. RT again throws him: he breaks whoever he hits and dies where he lands."
