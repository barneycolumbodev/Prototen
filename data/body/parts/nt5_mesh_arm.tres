mount = &"arm_left"
mass_kg = 5.5
power_draw_w = 25.0
heat_w = 15.0
capacity = 3
modifiers = Array[ExtResource("2")]([])
requirements = Array[ExtResource("5")]([SubResource("req_0"), SubResource("req_1")])
synergy = "Needs strength ×1.15 (EM-2, HM-5) and structure ×1.20. Throw speed = 17 m/s × usable strength ÷ 1.15 × √impact: the Juggernaut throws a man through a wall. Takes the left arm: not with the BW-6 shield; guns go away while it's out, the GX-4 doesn't."
