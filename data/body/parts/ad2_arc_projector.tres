[resource]
script = ExtResource("1")
id = &"ad2_arc_projector"
display_name = "AD-2 Arc Projector"
description = "An electrolaser on a mast over the right shoulder. A UV laser ionizes a channel to whoever you're looking at and a capacitor bank dumps down it; the arc jumps on to the next body in reach, and the next. The gun stays in your hands. Select it on the D-pad; LB raises it and fires, LB again fires the second charge. Each discharge takes 18 kJ straight out of the power reserve."
location = 15
mass_kg = 5.0
power_draw_w = 15.0
heat_w = 10.0
capacity = 3
modifiers = Array[ExtResource("2")]([])
requirements = Array[ExtResource("5")]([SubResource("req_0")])
synergy = "Needs a 600 W supply (PC-3 power cell). Each arc costs 18 kJ of reserve: a 60 kJ reserve holds three. An FB-1 fuel bladder doubles the reserve and adds two links to the chain. Spare power refills its charges faster."
visuals = Array[ExtResource("3")]([SubResource("vis_0")])
behaviour = ExtResource("4")
short_name = "AD-2"
