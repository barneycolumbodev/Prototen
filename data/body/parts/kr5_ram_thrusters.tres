script = ExtResource("1")
id = &"kr5_ram_thrusters"
display_name = "KR-5 Ram Thrusters"
description = "Two cold-gas thrusters on the shoulder blades. One press throws you forward along your view at up to 27 m/s for a quarter of a second, through anyone in the way. Two burns stored. Select it on the D-pad, LB fires."
