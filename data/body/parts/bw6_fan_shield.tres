[resource]
script = ExtResource("1")
id = &"bw6_fan_shield"
display_name = "BW-6 Bulwark Fan Shield"
description = "Seven boron-carbide leaves on a hub on the left forearm. They fan out into half a disc of shield in half a second. Rounds from the front are stopped and their energy comes out of the shield's integrity; at zero it breaks and needs five seconds. Select it on the D-pad, LB to raise or fold it. The R3 strike becomes a shield bash."
