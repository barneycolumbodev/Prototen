[resource]
script = ExtResource("1")
id = &"sx8_urticating_setae"
display_name = "SX-8 Urticating Setae"
description = "A bank of 24 ports along the back of the left forearm, each over a nanite assembler. LB brings the arm up and the assemblers grow two long, hair-thin fibres out of every port while the world slows to a crawl. LT marks the body part under the crosshair: four marks, five with sharp eyes, several on one man if you like. RT throws: time comes back, the arm whips across, the fibres stiffen into needles in flight and home on their marks. Each bundle leaves a cavitation wound that takes most men apart."
location = 6
mount = &"arm_left"
mass_kg = 3.0
power_draw_w = 15.0
heat_w = 10.0
capacity = 2
modifiers = Array[ExtResource("2")]([])
requirements = Array[ExtResource("5")]([SubResource("req_0")])
synergy = "Needs processing ×1.15 (SA-2). Processing stretches the marking time (5 s at ×1.20); perception ×1.20 (OB-5, TG-6) gives the fifth mark; usable strength sets how fast the needles fly and how hard each cavity hits (the Operator's bursts a torso; a light body only kills). The fibres regrow in about 12 s, faster with spare power. Takes the left arm: not with the NT-5 or the BW-6; the gun goes down while it's out."
visuals = Array[ExtResource("3")]([SubResource("vis_0")])
behaviour = ExtResource("4")
short_name = "SX-8"
deploy_time = 0.45
recover_time = 0.35
cooldown_time = 0.3
charge_max = 1.0
drain_per_s = 0.0
regen_per_s = 0.08
regen_delay = 0.5
min_to_start = 1.0
active_power_w = 80.0
active_heat_w = 220.0
scene = ExtResource("6")
viewmodel = SubResource("view")
