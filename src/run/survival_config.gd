class_name SurvivalConfig
extends Resource
## Everything a Survival run is tuned by (docs/design.md §8): the starting
## picks, the supply-drop pool and its odds, and the waves.
## data/run/survival.tres, generated by tools/run/gen_pool.py.

## The body frame the run's parts sit on (capacity, base stats).
@export var frame: PlayerBodyConfig = preload("res://data/player/body_default.tres")

@export_group("Start (§8.2)")
@export var doctrines: Array[Doctrine] = []
## The guns you can start with (owner: Five-seveN, MP5, Saiga-12K).
@export var starter_weapons: Array[WeaponData] = []

@export_group("Supply drops (§8.4)")
@export var pool: Array[RunItem] = []
## Odds of each kind of drop (relative), when that kind has anything left to give.
@export var weapon_odds: float = 0.25
@export var active_odds: float = 0.25
@export var passive_odds: float = 0.5
## A mark for an active you own, from this wave on, at these odds.
@export var mark_odds: float = 0.06
@export var mark_from_wave: int = 6
## Chance a drop is a choice of two (else one item, picked for you). The
## first drop of a run is always a choice.
@export_range(0.0, 1.0) var choice_chance: float = 0.55
## Affinity: each owned item adds this much to the weight of its tags…
@export var affinity_per_item: float = 0.35
## …up to this multiplier.
@export var affinity_max: float = 3.0
## Guns stop dropping once you carry this many.
@export var max_guns: int = 4

@export_group("Waves (§8.6)")
@export var roster: Array[WaveEnemy] = []
## Threat budget of wave n: base + per_wave·(n-1) + accel·(n-1)².
@export var budget_base: float = 5.0
@export var budget_per_wave: float = 2.2
@export var budget_accel: float = 0.11
## The wave after a boss starts this much lower (fraction of its budget).
@export_range(0.0, 1.0) var after_boss_dip: float = 0.2
## Every n-th wave is a boss wave (until bosses exist: a lieutenant wave).
@export var boss_every: int = 5
## The bosses in order (data/enemies/<role>.tres with a BossConfig): the
## first boss wave brings the first, and so on. A boss wave past the end of
## the list is a lieutenant wave.
@export var bosses: Array[String] = []
## A boss comes with escorts worth this share of the wave's budget; they
## start arriving `boss_escort_delay` s after his entrance begins.
@export_range(0.0, 1.0) var boss_escort_budget: float = 0.45
@export var boss_escort_delay: float = 6.0
## Lieutenant waves: these roles first, the rest of the budget (× fraction) as usual.
@export var lieutenant_roles: Array[String] = ["red_pole", "red_pole"]
@export_range(0.0, 1.0) var lieutenant_budget: float = 0.7
## Seconds between a wave clearing and the supply drop, and from the drop to the next wave.
@export var drop_delay: float = 2.0
@export var next_wave_delay: float = 3.0


func doctrine_named(n: String) -> Doctrine:
	for d: Doctrine in doctrines:
		if d.display_name == n:
			return d
	return null


func item_for(res: Resource) -> RunItem:
	for it: RunItem in pool:
		if it.item == res:
			return it
	return null


func item_by_id(id: StringName) -> RunItem:
	for it: RunItem in pool:
		if it.id() == id:
			return it
	return null


func is_boss_wave(wave: int) -> bool:
	return boss_every > 0 and wave > 0 and wave % boss_every == 0


## The boss role for wave `wave`, or "" (not a boss wave, or no boss left: lieutenants).
func boss_for(wave: int) -> String:
	if not is_boss_wave(wave):
		return ""
	var i: int = wave / boss_every - 1
	return bosses[i] if i >= 0 and i < bosses.size() else ""
